PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/serviceflow
DATABASE_SSL=false
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Where magic links point (Next.js client)
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# S3-compatible storage (Cloudflare R2 / AWS S3) for deliverable uploads
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Paddle Billing (SaaS subscriptions). Use sandbox until launch.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO=
PADDLE_PRICE_AGENCY=
